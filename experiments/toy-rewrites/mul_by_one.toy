# RUN: toyc-ch3 %s -emit=mlir -opt 2>&1 | FileCheck %s

# mul(x, 1) -> x  and  mul(1, x) -> x  (SimplifyMulByOne canonicalization)

def f(a) {
  return a * 1;
}

def g(a) {
  return 1 * a;
}

def main() {
  var a = [[1, 2], [3, 4]];
  print(f(a));
  print(g(a));
}

# CHECK-LABEL: toy.func @f(
# CHECK-SAME:              [[VAL_0:%.*]]: tensor<*xf64>) -> tensor<*xf64>
# CHECK-NEXT:    toy.return [[VAL_0]] : tensor<*xf64>

# CHECK-LABEL: toy.func @g(
# CHECK-SAME:              [[VAL_1:%.*]]: tensor<*xf64>) -> tensor<*xf64>
# CHECK-NEXT:    toy.return [[VAL_1]] : tensor<*xf64>

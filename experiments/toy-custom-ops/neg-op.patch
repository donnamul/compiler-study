diff --git a/mlir/examples/toy/Ch2/include/toy/Ops.td b/mlir/examples/toy/Ch2/include/toy/Ops.td
index 91bf83a54..6a3c035b4 100644
--- a/mlir/examples/toy/Ch2/include/toy/Ops.td
+++ b/mlir/examples/toy/Ch2/include/toy/Ops.td
@@ -332,4 +332,25 @@ def TransposeOp : Toy_Op<"transpose"> {
   let hasVerifier = 1;
 }
 
+//===----------------------------------------------------------------------===//
+// NegOp
+//===----------------------------------------------------------------------===//
+
+def NegOp : Toy_Op<"neg"> {
+  let summary = "element-wise negation";
+
+  let arguments = (ins F64Tensor:$input);
+  let results = (outs F64Tensor);
+  
+  let assemblyFormat = [{
+    `(` $input `:` type($input) `)` attr-dict `to` type(results)
+  }];
+
+  // Allow building a NegOp from the input operand.
+  let builders = [
+    OpBuilder<(ins "Value":$input)>
+  ];
+
+}
+
 #endif // TOY_OPS
